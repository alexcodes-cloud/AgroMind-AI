{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agromind.example/contracts/weather.schema.json",
  "title": "AgroMind Weather Snapshot",
  "description": "Weather API snapshot and forecast for the farm location.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "farm_id",
    "source",
    "retrieved_at",
    "location",
    "current",
    "forecast"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "farm_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "current": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_humidity_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "wind_speed_kmh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "precipitation_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "et0_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "valid_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "forecast": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time"
        ],
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "temperature_c": {
            "type": [
              "number",
              "null"
            ]
          },
          "relative_humidity_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "wind_speed_kmh": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "precipitation_mm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "et0_mm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
