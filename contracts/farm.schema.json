{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agromind.example/contracts/farm.schema.json",
  "title": "AgroMind Farm Dataset",
  "description": "Synthetic or collected farm metadata, crop zones, sensor measurements, and drone-derived observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "farm_id",
    "farm_name",
    "location",
    "zones"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "farm_id": {
      "type": "string",
      "minLength": 1
    },
    "farm_name": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "crop_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "variety": {
          "type": [
            "string",
            "null"
          ]
        },
        "growth_stage": {
          "type": "string"
        },
        "soil_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "area_ha",
          "crop",
          "sensors"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "area_ha": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "polygon_geojson": {
            "type": [
              "object",
              "null"
            ],
            "description": "Optional GeoJSON geometry for mapping. Keep null when coordinates are unavailable."
          },
          "crop": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "growth_stage"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "variety": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "growth_stage": {
                "type": "string",
                "minLength": 1
              },
              "soil_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "sensors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record_id",
                "field",
                "value",
                "unit",
                "measured_at",
                "quality"
              ],
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sensor_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "field": {
                  "type": "string",
                  "enum": [
                    "soil_moisture",
                    "soil_temperature",
                    "soil_ph",
                    "nitrogen",
                    "phosphorus",
                    "potassium",
                    "electrical_conductivity",
                    "air_temperature",
                    "relative_humidity"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "depth_cm": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "measured_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "quality": {
                  "enum": [
                    "valid",
                    "suspect",
                    "invalid",
                    "missing"
                  ]
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "drone_observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record_id",
                "observation",
                "source_type",
                "observed_at"
              ],
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "source_type": {
                  "enum": [
                    "simulated",
                    "human_annotation",
                    "model_output",
                    "measured"
                  ]
                },
                "image_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "management_history": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "last_irrigation_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "last_fertilization_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
