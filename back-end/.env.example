# Local development defaults. Keep real credentials in a non-committed .env file.
AGROMIND_ENV=local
AGROMIND_API_PREFIX=/api/v1
AGROMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://agromind-ai-dashboard.vercel.app
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
# Gemma 4: minimal disables extended thinking; high enables it.
GEMINI_THINKING_LEVEL=minimal
AGROMIND_DEMO_MODE=false
# Explicit local fallback for a live hackathon demo when Gemini is unavailable.
# This is not AI-generated output and is disabled by default.
AGROMIND_DEMO_FALLBACK=false
# Analyze only this many zones per dashboard run; 0 means all zones.
AGROMIND_ANALYSIS_ZONE_LIMIT=4
# Keep only this many sensor/drone examples per selected zone; 0 means all.
AGROMIND_ANALYSIS_RECORD_LIMIT=2
# Keep false for Gemma models unless the selected model supports response_schema.
GEMINI_STRUCTURED_OUTPUT=false
# Split Stage 1 into smaller provider requests to reduce Gemini timeouts.
AGROMIND_BATCH_SIZE=1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10
AGROMIND_FARM_DATA_PATH=data-set/synthetic_farm.json
AGROMIND_WEATHER_FIXTURE_PATH=contracts/example-weather.json
